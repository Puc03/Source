// ── COLORS ──────────────────────────────────────────────────────────
const C = {
  navy: "0F3460", blue: "1565C0", green: "1AA37A", orange: "E87722",
  teal: "0097A7", gray: "4A6080", lgray: "8094B0", white: "FFFFFF",
  bgblue: "EBF4FF", bggreen: "E8F5E9", bgorg: "FFF3E0", bggray: "F4F7FC",
  line: "D0D9E8", red: "C62828"
};

// ── DIMENSIONS (A4, 2cm margins) ────────────────────────────────────
const PW = 11906; const ML = 1134; const MR = 1134;
const CW = PW - ML - MR; // 9638

// ── HELPERS ─────────────────────────────────────────────────────────
const sp  = (b=0,a=80) => ({before:b,after:a});
const b1  = col => ({style:BorderStyle.SINGLE,size:1,color:col||C.line});
const bds = col => ({top:b1(col),bottom:b1(col),left:b1(col),right:b1(col)});
const nb  = ()  => ({top:b1("FFFFFF"),bottom:b1("FFFFFF"),left:b1("FFFFFF"),right:b1("FFFFFF")});
const nosp= sp(0,0);
const fn  = (text,opts={}) => new TextRun({
  text, font:"Times New Roman", bold:opts.b||false, italics:opts.i||false,
  color:opts.c||"000000", size:opts.s||24, highlight:opts.hl
});
const p   = (ch,opts={}) => new Paragraph({
  children: Array.isArray(ch)?ch:[ch],
  spacing: opts.sp||sp(0,80), alignment:opts.al||AlignmentType.JUSTIFIED,
  indent:opts.in, numbering:opts.num, heading:opts.h
});
const cell= (ch,w,opts={}) => new TableCell({
  borders: opts.nb?nb():bds(opts.bc||C.line),
  shading: opts.fill?{fill:opts.fill,type:ShadingType.CLEAR}:undefined,
  width:{size:w,type:WidthType.DXA},
  margins: opts.mg||{top:80,bottom:80,left:120,right:120},
  verticalAlign:opts.va||VerticalAlign.TOP,
  columnSpan:opts.span,
  children:Array.isArray(ch)?ch:[ch]
});
const row = cells => new TableRow({children:cells});
const tbl = (rows,widths) => new Table({
  width:{size:widths.reduce((a,b)=>a+b,0),type:WidthType.DXA},
  columnWidths:widths, rows
});
const spacer = () => p([fn("")],{sp:sp(0,40)});

// heading helpers
const h1 = txt => new Paragraph({
  children:[fn(txt,{b:true,s:26,c:C.navy})],
  spacing:sp(280,100),
  border:{bottom:{style:BorderStyle.SINGLE,size:8,color:C.blue,space:3}}
});
const h2 = txt => new Paragraph({
  children:[fn(txt,{b:true,s:24,c:C.blue})],
  spacing:sp(200,60)
});
const h3 = txt => new Paragraph({
  children:[fn(txt,{b:true,s:22,c:C.teal})],
  spacing:sp(140,40)
});

// chapter title
const chTitle = txt => new Paragraph({
  children:[fn(txt,{b:true,s:28,c:C.navy})],
  spacing:sp(0,120), alignment:AlignmentType.CENTER,
  border:{bottom:{style:BorderStyle.SINGLE,size:10,color:C.navy,space:4}}
});

// phase strip
const phaseStrip = (num,title,sub) => {
  const W1=1440, W2=CW-1440;
  return tbl([row([
    cell(p([fn("PHASE "+num,{b:true,s:20,c:C.white})],{sp:nosp,al:AlignmentType.CENTER}),
        W1,{fill:C.navy,bc:C.navy,va:VerticalAlign.CENTER,mg:{top:100,bottom:100,left:80,right:80}}),
    cell([
      p([fn(title,{b:true,s:20,c:C.navy})],{sp:sp(0,8)}),
      sub?p([fn(sub,{s:18,c:C.gray,i:true})],{sp:nosp}):null
    ].filter(Boolean),W2,{fill:C.bgblue,bc:C.bgblue,mg:{top:80,bottom:80,left:180,right:120}})
  ])],[W1,W2]);
};

// note box
const noteBox = (icon,text,bc,bg) => {
  const W1=360,W2=CW-360;
  return tbl([row([
    cell(p([fn(icon,{b:true,s:22,c:C.white})],{sp:nosp,al:AlignmentType.CENTER}),
        W1,{fill:bc,bc:bc,va:VerticalAlign.CENTER,mg:{top:80,bottom:80,left:60,right:60}}),
    cell(p([fn(text,{s:20})],{sp:nosp,al:AlignmentType.JUSTIFIED}),
        W2,{fill:bg,nb:false,
            border:{top:b1(bc),bottom:b1(bc),right:b1(bc),left:{style:BorderStyle.NONE,size:0,color:"FFFFFF"}},
            mg:{top:100,bottom:100,left:140,right:120}})
  ])],[W1,W2]);
};

// KPI row
const kpiRow = items => {
  const w = Math.floor(CW/items.length);
  return tbl([row(items.map(it=>cell([
    p([fn(it.val,{b:true,s:26,c:it.vc||C.blue})],{sp:sp(0,4),al:AlignmentType.CENTER}),
    p([fn(it.lbl,{s:17,c:C.gray})],{sp:nosp,al:AlignmentType.CENTER})
  ],w,{fill:it.bg||C.bgblue,bc:it.vc||C.blue,va:VerticalAlign.CENTER,mg:{top:100,bottom:100,left:60,right:60}})))],
  items.map(()=>w));
};

// header row helper
const hRow = (cols,ws,fill) => row(cols.map((c,i)=>cell(
  p([fn(c,{b:true,s:19,c:C.white})],{sp:nosp}),
  ws[i],{fill:fill||C.navy,bc:fill||C.navy,va:VerticalAlign.CENTER,mg:{top:80,bottom:80,left:100,right:80}}
)));

// data row helper
const dRow = (vals,ws,even,colors) => row(vals.map((v,i)=>cell(
  p([fn(String(v??'—'),{s:18,c:colors&&colors[i]?colors[i]:"1A2A4A"})],{sp:nosp}),
  ws[i],{fill:even?C.bggray:C.white,bc:C.line,mg:{top:65,bottom:65,left:100,right:80}}
)));

const tblTitle = txt => p([fn("Bảng: "+txt,{b:true,s:19,c:C.gray,i:true})],
  {sp:sp(60,30),al:AlignmentType.CENTER});

function num(v,dp=2){return typeof v==='number'?v.toFixed(dp):String(v??'—');}
function pct(v){return num(v,2)+'%';}

